PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/startupplanner
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI provider: gemini | openai | mock  (mock returns sample data, no API key needed)
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
